<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head", { title: "My Eventure | Eventure" }) %>
    <link rel="stylesheet" href="/css/user/dashboard.css">
</head>

<body class="dashboard-page">

  <div class="dashboard-layout">

    <%- include("../partials/sidebar", { activePage: "dashboard" }) %>

      <main class="dashboard-content">

        <header class="dashboard-header">
          <div>
            <p class="welcome-label">YOUR EVENTURE JOURNEY</p>
            <h1>Welcome back, <span id="userName">there</span> <span class="welcome-wave">👋</span></h1>
            <p class="welcome-text">
              Your next unforgettable experience is waiting to be discovered.
            </p>
          </div>

          <a href="/events" class="header-explore-btn">
            Explore events <span aria-hidden="true">↗</span>
          </a>
        </header>

        <section class="dashboard-hero">
          <div class="dashboard-hero-content">
            <span class="hero-eyebrow">MAKE YOUR MOMENTS COUNT</span>
            <h2>Find your next<br> unforgettable experience.</h2>
            <p>From live music to inspiring experiences, discover something worth looking forward to.</p>
            <a href="/events" class="hero-btn">
              Discover events <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="dashboard-hero-art" aria-hidden="true">
            <div class="hero-orbit hero-orbit-one"></div>
            <div class="hero-orbit hero-orbit-two"></div>
            <div class="hero-ticket">
              <span class="ticket-icon">✦</span>
              <span class="ticket-line"></span>
              <span class="ticket-line ticket-line-short"></span>
              <span class="ticket-bottom">YOUR NEXT EXPERIENCE</span>
            </div>
            <span class="hero-spark hero-spark-one">✦</span>
            <span class="hero-spark hero-spark-two">✧</span>
          </div>
        </section>

        <section class="dashboard-section">

          <div class="section-header">
            <div>
              <p class="section-label">CURATED FOR YOU</p>
              <h2>Upcoming events</h2>
              <p class="section-description">Explore experiences you won't want to miss.</p>
            </div>

            <a href="/events" class="view-all">
              Explore all events <span aria-hidden="true">→</span>
            </a>
          </div>

          <div id="dashboardEvents" class="event-grid">
            <div class="dashboard-empty-state">
              <div class="empty-state-icon">✦</div>
              <h3>Finding experiences for you</h3>
              <p>We're bringing together the latest events. Just a moment.</p>
            </div>
          </div>

        </section>

        <section class="dashboard-section quick-section">

          <div class="section-header">
            <div>
              <p class="section-label">YOUR EVENTURE</p>
              <h2>Everything you need</h2>
              <p class="section-description">Your tickets, profile, and hosting journey in one place.</p>
            </div>
          </div>

          <div class="quick-actions">

            <a href="/events" class="quick-card quick-card-primary">
              <div class="quick-card-icon">⌕</div>
              <div class="quick-card-content">
                <h3>Explore events</h3>
                <p>Discover experiences happening around you.</p>
              </div>
              <span class="quick-card-arrow" aria-hidden="true">↗</span>
            </a>

            <a href="/user/bookings" class="quick-card">
              <div class="quick-card-icon">▤</div>
              <div class="quick-card-content">
                <h3>My tickets</h3>
                <p>Keep your bookings and event tickets close.</p>
              </div>
              <span class="quick-card-arrow" aria-hidden="true">↗</span>
            </a>

            <a href="/profile" class="quick-card">
              <div class="quick-card-icon">♙</div>
              <div class="quick-card-content">
                <h3>My profile</h3>
                <p>Manage your account and personal details.</p>
              </div>
              <span class="quick-card-arrow" aria-hidden="true">↗</span>
            </a>

            <a href="/apply-host" class="quick-card">
              <div class="quick-card-icon">✧</div>
              <div class="quick-card-content">
                <h3>Become a host</h3>
                <p>Bring your own event to the Eventure community.</p>
              </div>
              <span class="quick-card-arrow" aria-hidden="true">↗</span>
            </a>

          </div>

        </section>

      </main>

  </div>

  <script src="/js/auth-guard.js"></script>
  <script src="/js/user/dashboard.js"></script>

</body>

</html>