<%- include("../partials/head", { title: "Host Applications | Eventure Admin" }) %>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/admin/host-applications.css">
<link rel="stylesheet" href="/css/common/admin-sidebar.css">

<body>

  <div class="admin-layout">

    <%- include("../partials/admin-sidebar", { activePage: "host-applications" }) %>

    <main class="main-content">

      <header class="page-header">

        <div>

          <div class="eyebrow">
            HOST MANAGEMENT
          </div>

          <h1>
            Host Applications
          </h1>

          <p>
            Review and manage Eventure host applications.
          </p>

        </div>

      </header>

      <section class="filter-card">

        <div class="filter-wrapper">

          <label for="searchInput">
            Search
          </label>

          <input
            type="text"
            id="searchInput"
            placeholder="Search by applicant or organization..."
            autocomplete="off"
          >

        </div>

        <div class="filter-wrapper">

          <label for="statusFilter">
            Application Status
          </label>

          <select id="statusFilter">

            <option value="">
              All Applications
            </option>

            <option value="pending">
              Pending
            </option>

            <option value="approved">
              Approved
            </option>

            <option value="rejected">
              Rejected
            </option>

          </select>

        </div>

        <button
          type="button"
          id="searchBtn"
          class="primary-btn"
        >
          Search
        </button>

        <button
          type="button"
          id="clearBtn"
          class="secondary-btn"
        >
          Clear
        </button>

      </section>

      <section class="applications-card">

        <div class="card-header">

          <div>

            <h2>
              Host Applications
            </h2>

            <p id="resultCount">
              Loading applications...
            </p>

          </div>

        </div>

        <div class="table-wrapper">

          <table>

            <thead>

              <tr>

                <th>
                  Applicant
                </th>

                <th>
                  Organization
                </th>

                <th>
                  Organization Type
                </th>

                <th>
                  Status
                </th>

                <th>
                  Submitted
                </th>

                <th>
                  Action
                </th>

              </tr>

            </thead>

            <tbody id="applicationTable">
            </tbody>

          </table>

        </div>

        <div
          id="emptyState"
          class="empty-state"
          style="display: none;"
        >

          <div>
            ▣
          </div>

          <h3>
            No applications found
          </h3>

          <p>
            There are no host applications matching your filter.
          </p>

        </div>

        <div class="pagination">

          <button
            type="button"
            id="previousBtn"
            class="page-btn"
          >
            ← Previous
          </button>

          <span id="pageInfo">
            Page 1
          </span>

          <button
            type="button"
            id="nextBtn"
            class="page-btn"
          >
            Next →
          </button>

        </div>

      </section>

      <p
        id="pageMessage"
        class="page-message"
      ></p>

    </main>

  </div>

  <script
    src="/js/admin/admin-auth.js"
  ></script>

  <script
    src="/js/admin/host-applications.js"
  ></script>

</body>
</html>