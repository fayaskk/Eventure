<!DOCTYPE html>

<html lang="en">

<head>

  <%- include("../partials/head", {
    title: "Reset Password | Eventure"
  }) %>

  <link
    rel="stylesheet"
    href="/css/auth/reset-password.css"
  />

</head>

<body>

  <main class="reset-page">

    <section class="reset-card">

      <div class="reset-heading">

        <p class="eyebrow">
          PASSWORD RECOVERY
        </p>

        <h1>
          Reset Your Password
        </h1>

        <p>
          Create a new password for your Eventure account.
        </p>

      </div>


      <form
        id="resetPasswordForm"
        novalidate
      >

        <div class="form-group">

          <label for="newPassword">
            New Password
          </label>

          <div class="password-wrapper">

            <input
              type="password"
              id="newPassword"
              placeholder="Enter your new password"
              autocomplete="new-password"
            />

            <button
              type="button"
              class="password-toggle"
              data-target="newPassword"
              id="newPasswordToggle"
            >
              👁
            </button>

          </div>

        </div>


        <div class="form-group">

          <label for="confirmPassword">
            Confirm New Password
          </label>

          <div class="password-wrapper">

            <input
              type="password"
              id="confirmPassword"
              placeholder="Confirm your new password"
              autocomplete="new-password"
            />

            <button
              type="button"
              class="password-toggle"
              data-target="confirmPassword"
              id="confirmPasswordToggle"
            >
              👁
            </button>

          </div>

        </div>


        <p class="password-hint">
          Password must contain at least 8 characters,
          including uppercase, lowercase and a number.
        </p>


        <button
          type="submit"
          class="reset-btn"
        >
          Reset Password
        </button>

      </form>


      <p class="login-text">

        Remember your password?

        <a href="/login">
          Sign In
        </a>

      </p>

    </section>

  </main>


  <script
    src="/js/auth/reset-password.js"
  ></script>

</body>

</html>