<!DOCTYPE html>

<html lang="en">

<head>

  <%- include("../partials/head", { title: "Create Account | Eventure" }) %>

  <link rel="stylesheet" href="/css/auth/register.css" />

</head>

<body>

  <script src="/js/auth-guard.js"></script>

  <script>

    redirectToDashboardIfLoggedIn();

    window.addEventListener(
      "pageshow",
      () => {
        redirectToDashboardIfLoggedIn();
      }
    );

  </script>


  <main class="register-page">

    <section class="register-hero">

      <div class="brand">

        <div class="brand-icon">

          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >

            <rect
              x="3"
              y="4"
              width="18"
              height="18"
              rx="3"
            ></rect>

            <line
              x1="16"
              y1="2"
              x2="16"
              y2="6"
            ></line>

            <line
              x1="8"
              y1="2"
              x2="8"
              y2="6"
            ></line>

            <line
              x1="3"
              y1="10"
              x2="21"
              y2="10"
            ></line>

          </svg>

        </div>

        <span>
          Eventure
        </span>

      </div>


      <div class="hero-content">

        <h1>
          Join Events<br>
          Create<br>
          <span>
            Memories
          </span>
        </h1>

        <p>
          Discover concerts, festivals,
          workshops, sports events and
          unforgettable experiences.
        </p>

      </div>

    </section>


    <section class="register-form-section">

      <div class="register-card">

        <div class="register-heading">

          <h2>
            Create Account
          </h2>

          <p>
            Join Eventure and start your journey.
          </p>

        </div>


        <form
          id="registerForm"
          class="auth-form"
          novalidate
        >

          <div class="form-group">

            <label for="name">
              Full Name
            </label>

            <input
              type="text"
              id="name"
              name="name"
              placeholder="Enter your full name"
              autocomplete="name"
              required
            />

          </div>


          <div class="form-group">

            <label for="email">
              Email Address
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="Enter your email"
              autocomplete="email"
              required
            />

          </div>


          <div class="form-group">

            <label for="password">
              Password
            </label>

            <div class="password-input-wrapper">

              <input
                type="password"
                id="password"
                name="password"
                placeholder="Create a password"
                autocomplete="new-password"
                required
              />

              <button
                type="button"
                class="password-toggle"
                data-target="password"
                aria-label="Show password"
              >
                👁
              </button>

            </div>

          </div>


          <div class="form-group">

            <label for="confirmPassword">
              Confirm Password
            </label>

            <div class="password-input-wrapper">

              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Confirm your password"
                autocomplete="new-password"
                required
              />

              <button
                type="button"
                class="password-toggle"
                data-target="confirmPassword"
                aria-label="Show password"
              >
                👁
              </button>

            </div>

          </div>


          <div class="form-group">

            <label for="referralCode">

              Referral Code

              <span>
                (Optional)
              </span>

            </label>

            <input
              type="text"
              id="referralCode"
              name="referralCode"
              placeholder="Enter referral code"
              autocomplete="off"
            />

          </div>


          <label class="terms">

            <input
              type="checkbox"
              name="terms"
              id="terms"
              required
            />

            <span>

              I agree to the

              <a href="#">
                Terms & Conditions
              </a>

              and

              <a href="#">
                Privacy Policy
              </a>

            </span>

          </label>


          <button
            type="submit"
            class="auth-submit-btn"
          >

            Create Account

            <span>
              →
            </span>

          </button>


          <div class="divider">

            <span></span>

            <p>
              OR
            </p>

            <span></span>

          </div>
<button
  type="button"
  class="google-auth-btn"
  id="googleAuthBtn"
>
  <span class="google-icon">
    G
  </span>
  <span>
    Continue with Google
  </span>
</button>


          <p class="login-text">

            Already have an account?

            <a href="/login">
              Sign In
            </a>

          </p>

        </form>

      </div>

    </section>

  </main>


  <%- include("../partials/footer") %>

  <script src="/js/auth/register.js"></script>

</body>

</html>