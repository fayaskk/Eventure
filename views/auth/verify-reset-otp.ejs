<!DOCTYPE html>

<html lang="en">

<head>

  <%- include("../partials/head", {
    title: "Verify Reset OTP | Eventure"
  }) %>

  <link
    rel="stylesheet"
    href="/css/auth/verify-reset-otp.css"
  />

</head>

<body>

  <main class="verify-reset-page">

    <section class="verify-reset-card">

      <div class="verify-heading">

        <p class="eyebrow">
          PASSWORD RECOVERY
        </p>

        <h1>
          Verify Reset Code
        </h1>

        <p>
          We sent a 6-digit verification code to

          <strong id="verificationEmail">
            your email address
          </strong>

        </p>

      </div>


      <form
        id="verifyResetOtpForm"
        novalidate
      >

        <div class="form-group">

          <label for="otp">
            Enter OTP
          </label>

          <input
            type="text"
            id="otp"
            name="otp"
            inputmode="numeric"
            maxlength="6"
            autocomplete="one-time-code"
            placeholder="Enter 6-digit code"
          >

        </div>


        <button
          type="submit"
          class="verify-btn"
        >
          Verify OTP
        </button>

      </form>


      <div class="resend-section">

        <p>
          Didn't receive the code?
        </p>

        <button
          id="resendOtpBtn"
          type="button"
          class="resend-btn"
        >
          Resend OTP
        </button>

      </div>


      <p class="login-text">

        Remember your password?

        <a href="/login">
          Sign In
        </a>

      </p>

    </section>

  </main>


  <script
    src="/js/auth/verify-reset-otp.js"
  ></script>

</body>

</html>