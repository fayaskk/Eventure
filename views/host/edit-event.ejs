<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../partials/head", { title: "Eventure | Edit Event" }) %>
    <link rel="stylesheet" href="/css/host/edit-event.css">
</head>

<body>

  <%- include("../partials/sidebar", { activePage: "events" }) %>

    <main class="host-main">

      <header class="host-header">

        <div>
          <p class="section-label">HOST PANEL</p>

          <h1>Edit Event</h1>

          <p>
            Update your event details.
          </p>
        </div>

        <a href="/host/events" class="back-btn">
          ← Back to My Events
        </a>

      </header>

      <form id="editEventForm">

        <section class="form-section">

          <h2>Basic Information</h2>

          <div class="form-group">

            <label for="eventName">
              Event Name
            </label>

            <input type="text" id="eventName" maxlength="100" required>

            <p id="eventNameError" class="field-error"></p>

          </div>

          <div class="form-group">

            <label for="description">
              Description
            </label>

            <textarea id="description" rows="6" maxlength="2000" required></textarea>

            <p id="descriptionError" class="field-error"></p>

          </div>

          <div class="form-group">

            <label for="category">
              Category
            </label>

            <select id="category" required>
              <option value="">
                Select Category
              </option>
            </select>

            <p id="categoryError" class="field-error"></p>

          </div>

        </section>

        <section class="form-section">

          <h2>Event Banner</h2>

          <div class="current-banner">

            <p class="banner-label">
              Current Banner
            </p>

            <img id="currentBanner" src="" alt="Current event banner">

          </div>

          <div class="form-group">

            <label for="banner">
              Replace Banner
            </label>

            <input type="file" id="banner" accept="image/jpeg,image/png,image/webp">

            <p class="input-hint">
              Leave empty to keep the current banner.
              Maximum size: 5 MB.
            </p>

            <p id="bannerError" class="field-error"></p>

          </div>

          <div id="newBannerPreview" class="new-banner-preview" hidden>
            <p class="banner-label">
              New Banner Preview
            </p>

            <img id="newBannerImage" src="" alt="New banner preview">
          </div>

        </section>
        <section class="form-section">
          <h2>Promotional Video</h2>

          <div id="currentPromoVideoSection" class="current-promo-video" hidden>
            <p class="video-label">Current Promotional Video</p>

            <video id="currentPromoVideo" controls preload="metadata">
              Your browser does not support video playback.
            </video>
          </div>

          <div class="form-group">
            <label for="promoVideo">Replace Promotional Video</label>

            <input type="file" id="promoVideo" accept="video/mp4,video/webm">

            <p class="input-hint">
              Leave empty to keep the current video. Accepted formats: MP4 and WebM.
              Maximum size: 5 MB.
            </p>

            <p id="promoVideoError" class="field-error"></p>
          </div>

          <div id="newPromoVideoPreview" class="new-promo-video-preview" hidden>
            <p class="video-label">Replacement Video Preview</p>

            <video id="newPromoVideo" controls preload="metadata">
              Your browser does not support video playback.
            </video>

            <button type="button" id="removePromoVideoBtn" class="secondary-btn">
              Remove Selected Video
            </button>
          </div>
        </section>
        <section class="form-section">

          <h2>Location</h2>

          <div class="form-grid">

            <div class="form-group">

              <label for="venue">
                Venue
              </label>

              <input type="text" id="venue" required>

              <p id="venueError" class="field-error"></p>

            </div>

            <div class="form-group">

              <label for="city">
                City
              </label>

              <input type="text" id="city" required>

              <p id="cityError" class="field-error"></p>

            </div>

            <div class="form-group full-width">

              <label for="address">
                Address
              </label>

              <input type="text" id="address" required>

              <p id="addressError" class="field-error"></p>

            </div>

            <div class="form-group">

              <label for="state">
                State
              </label>

              <input type="text" id="state" required>

              <p id="stateError" class="field-error"></p>

            </div>

            <div class="form-group">

              <label for="pincode">
                Pincode
              </label>

              <input type="text" id="pincode" maxlength="6" required>

              <p id="pincodeError" class="field-error"></p>

            </div>

          </div>

        </section>

        <section class="form-section">

          <h2>Schedule</h2>

          <div class="form-grid">

            <div class="form-group">

              <label for="eventDate">
                Event Date
              </label>

              <input type="date" id="eventDate" required>

              <p id="eventDateError" class="field-error"></p>

            </div>

            <div></div>

            <div class="form-group">

              <label for="startTime">
                Start Time
              </label>

              <input type="time" id="startTime" required>

              <p id="startTimeError" class="field-error"></p>

            </div>

            <div class="form-group">

              <label for="endTime">
                End Time
              </label>

              <input type="time" id="endTime" required>

              <p id="endTimeError" class="field-error"></p>

            </div>

          </div>

        </section>

        <section class="form-section">

          <div class="section-heading">

            <div>
              <h2>Tickets</h2>

              <p>
                Update your ticket types and quantities.
              </p>
            </div>

            <button type="button" id="addTicketBtn" class="secondary-btn">
              + Add Ticket
            </button>

          </div>

          <div id="ticketsContainer"></div>

          <p id="ticketsError" class="field-error"></p>

        </section>

        <section class="form-section">

          <h2>Booking Settings</h2>

          <label class="checkbox-row">

            <input type="checkbox" id="allowAfterStart">

            <span>
              Allow booking after the event has started
            </span>

          </label>

        </section>

        <div class="form-actions">

          <a href="/host/events" class="cancel-btn">
            Cancel
          </a>

          <button type="submit" id="updateEventBtn" class="update-btn">
            Update Event
          </button>

        </div>

      </form>

    </main>

    <script src="/js/host/edit-event.js"></script>

</body>

</html>