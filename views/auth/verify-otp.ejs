<!DOCTYPE html>

<html lang="en">

<head>

  <%- include("../partials/head", {
    title: "Verify Email | Eventure"
  }) %>

  <link
    rel="stylesheet"
    href="/css/auth/verify-otp.css"
  />

</head>

<body>

  <main class="verify-page">

    <section class="verify-card">

      <div class="verify-heading">

        <p class="eyebrow">
          ACCOUNT VERIFICATION
        </p>

        <h1>
          Verify Your Email
        </h1>

        <p>
          We sent a 6-digit verification code to

          <strong id="verificationEmail">
            your email address
          </strong>

        </p>

      </div>


      <form id="verifyOtpForm" novalidate>

        <div class="form-group">

          <label for="otp">
            Enter OTP
          </label>

          <input
            type="text"
            id="otp"
            name="otp"
            inputmode="numeric"
            maxlength="6"
            autocomplete="one-time-code"
            placeholder="Enter 6-digit code"
            required
          />

        </div>


        <button
          type="submit"
          class="verify-btn"
        >
          Verify Email
        </button>

      </form>


      <p
        id="otpMessage"
        class="message"
      ></p>


      <div class="resend-section">

        <p>
          Didn't receive the code?
        </p>

        <button
          id="resendOtpBtn"
          type="button"
          class="resend-btn"
          disabled
        >

          Resend OTP in

          <span id="resendTimer">60</span>s

        </button>

      </div>


      <p class="login-text">

        Already verified?

        <a href="/login">
          Sign In
        </a>

      </p>

    </section>

  </main>


  <script src="/js/auth/verify-otp.js"></script>

</body>

</html>