<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Eventure | Discover Experiences" }) %>

  <link rel="stylesheet" href="/css/common/navbar.css">
  <link rel="stylesheet" href="/css/home.css">
</head>

<body class="home-page">

  <%- include("partials/navbar", { activePage: "home" }) %>

  <main>

    <section class="hero-section">

      <div class="hero-background-glow hero-glow-one"></div>
      <div class="hero-background-glow hero-glow-two"></div>

      <div class="hero-container">

        <div class="hero-content">

          <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            DISCOVER EXPERIENCES THAT MATTER
          </div>

          <h1>
            Discover events.
            <span>Create memories.</span>
          </h1>

          <p class="hero-description">
            From unforgettable concerts to exciting sports events,
            discover experiences that bring people together.
            Your next great memory starts here.
          </p>

          <div class="hero-actions">

            <a href="/events" class="primary-btn">
              Explore Events
              <i class="bi bi-arrow-up-right"></i>
            </a>

            <a href="/register" class="secondary-btn">
              Join Eventure
            </a>

          </div>

          <div class="hero-trust">

            <div class="trust-item">
              <i class="bi bi-calendar-event"></i>
              <span>Discover events</span>
            </div>

            <div class="trust-divider"></div>

            <div class="trust-item">
              <i class="bi bi-ticket-perforated"></i>
              <span>Book your tickets</span>
            </div>

            <div class="trust-divider"></div>

            <div class="trust-item">
              <i class="bi bi-heart"></i>
              <span>Create memories</span>
            </div>

          </div>

        </div>

        <div class="hero-visual">

          <div class="visual-orbit orbit-one"></div>
          <div class="visual-orbit orbit-two"></div>

          <div class="visual-floating-card floating-card-top">

            <div class="floating-icon purple-icon">
              <i class="bi bi-music-note-beamed"></i>
            </div>

            <div>
              <span>Discover</span>
              <strong>Live Concerts</strong>
            </div>

          </div>

          <div class="hero-main-card">

            <div class="hero-card-image">

              <div class="hero-card-overlay"></div>

              <div class="hero-card-content">

                <span class="hero-card-tag">
                  YOUR NEXT EXPERIENCE
                </span>

                <h2>
                  Make every moment
                  <span>unforgettable.</span>
                </h2>

                <div class="hero-card-bottom">

                  <div class="hero-card-symbol">
                    <i class="bi bi-stars"></i>
                  </div>

                  <span>Something amazing awaits you.</span>

                </div>

              </div>

            </div>

          </div>

          <div class="visual-floating-card floating-card-bottom">

            <div class="floating-icon orange-icon">
              <i class="bi bi-ticket-perforated"></i>
            </div>

            <div>
              <span>Your journey</span>
              <strong>Starts Here</strong>
            </div>

            <i class="bi bi-arrow-up-right floating-arrow"></i>

          </div>

          <div class="visual-decoration decoration-one"></div>
          <div class="visual-decoration decoration-two"></div>

        </div>

      </div>

      <div class="hero-bottom-line"></div>

    </section>


    <section class="categories-section" id="categories">

      <div class="section-container">

        <div class="section-heading">

          <div>
            <p class="section-eyebrow">
              EXPLORE YOUR INTERESTS
            </p>

            <h2>
              Discover by Category
            </h2>

            <p class="section-description">
              Find experiences that match your interests
              and discover something new.
            </p>
          </div>

          <a href="/events" class="section-link">
            Explore all events
            <i class="bi bi-arrow-up-right"></i>
          </a>

        </div>


        <div
          id="categories-container"
          class="categories-container"
        >

          <div class="categories-loading">
            <div class="loading-spinner"></div>
            <span>Discovering categories...</span>
          </div>

        </div>

      </div>

    </section>


    <section class="home-cta-section">

      <div class="cta-glow"></div>

      <div class="home-cta-content">

        <div class="cta-icon">
          <i class="bi bi-stars"></i>
        </div>

        <p class="section-eyebrow">
          YOUR NEXT CHAPTER STARTS HERE
        </p>

        <h2>
          Don't just hear about it.
          <span>Be part of it.</span>
        </h2>

        <p>
          Discover amazing events, connect with people
          and create memories worth sharing.
        </p>

        <a href="/events" class="primary-btn">
          Explore Experiences
          <i class="bi bi-arrow-up-right"></i>
        </a>

      </div>

    </section>

  </main>


  <footer class="home-footer">

    <div class="footer-container">

      <div class="footer-brand-section">

        <a href="/" class="footer-brand">
          <span class="footer-brand-icon">E</span>
          Eventure
        </a>

        <p>
          Discover experiences. Create memories.
        </p>

      </div>

      <div class="footer-links">

        <a href="/events">Explore Events</a>
        <a href="/register">Join Eventure</a>
        <a href="/login">Login</a>

      </div>

      <div class="footer-copyright">
        © <%= new Date().getFullYear() %> Eventure. All rights reserved.
      </div>

    </div>

  </footer>


  <script src="/js/auth-guard.js"></script>
  <script src="/js/home.js"></script>

</body>
</html>